# Dependencies installed with exact versions for reproducible builds.
save-exact=true
# pnpm workspaces use npm-compatible registry links.
link-workspace-packages=true

# React Native / Expo Android autolinking requires hoisted layout:
# transitive native modules (expo-modules-core etc.) must be resolvable
# from the generated Gradle project (documented Expo pnpm-monorepo fix).
node-linker=hoisted
