# MDEXS Flow — environment template (no real values; copy to .env and fill in)
# NEVER commit a real .env. All secrets stay local or in the deploy provider.

# ── API runtime ──────────────────────────────────────────────
# development | production
ENV=development
# Port for local uvicorn (Render injects PORT automatically)
PORT=8000
# Raise to debug during local development only
LOG_LEVEL=INFO

# ── Cloud database (backend-only; NEVER in the mobile app) ───
# Neon PostgreSQL pooled connection string. Empty in local dev: the API
# starts without a database and /health reports database status "skipped".
DATABASE_URL=
# postgres | postgresql+psycopg (binary driver, recommended for Neon)
DB_DRIVER=postgresql+psycopg

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated exact origins. Production must list real origins,
# never "*".
CORS_ORIGINS=http://localhost:8081
# Development-only convenience for Expo web previews
CORS_ALLOW_ALL=false

# ── Future integrations (unused in Phase 2; placeholders) ────
# Object storage (provider-neutral; backend issues signed URLs)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Public base URL for signed downloads
MEDIA_CDN_BASE_URL=

# ── Authentication (Phase 3) ──────────────────────────────────
# HMAC signing key for access JWTs. REQUIRED in production (>= 32 chars).
# In development an ephemeral per-process key is generated automatically,
# so local runs need no value here.
JWT_SECRET_KEY=
# Identity metadata embedded in each access token.
JWT_ISSUER=mdexs-flow-api
JWT_AUDIENCE=mdexs-flow-app
# Access-token lifetime (minutes) and refresh-session lifetime (days).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Google OIDC audiences the backend accepts (server-side, no secrets).
# Get these from Google Cloud Console → Credentials (OAuth 2.0 Client IDs).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Dev-grade per-IP rate limit for register/login (per minute).
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Mobile app (apps/mobile) ─────────────────────────────────
# Only non-secret values belong in the app bundle:
#   EXPO_PUBLIC_API_BASE_URL — public API origin, e.g. http://localhost:8000
#   EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID — Google OAuth *client ID* (public by
#     design; the backend holds no secret from the app, the app holds no
#     Google secret). Required to enable the Google sign-in button.
# Any privileged key that grants storage/admin access is forbidden here.
